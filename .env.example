# พอร์ตที่เซิร์ฟเวอร์ฟัง
PORT=3100
# URL จริงที่ผู้ใช้เปิด (ใช้กับลิงก์แชร์และ QR แข่งสด) — เว้นว่างได้ ระบบจะใช้ URL ที่ผู้ใช้เปิดเข้ามา
PUBLIC_BASE_URL=
# โฟลเดอร์เก็บฐานข้อมูล
DATA_DIR=./data
# เขตเวลาที่ใช้แสดงผล
APP_TIMEZONE=Asia/Bangkok
# บัญชีผู้ดูแลที่สร้างตอนเริ่มระบบ (ใช้งานจริง)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- AI ช่วยสร้างเนื้อหา (ไม่บังคับ) ----
# AI_PROVIDER=anthropic   หรือ openai (รองรับ API ที่เข้ากันได้กับ OpenAI)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# AI_API_URL=https://...   (ไม่บังคับ ต้องเป็น https)
